# Vorlage für die lokale .env. Hier stehen nie echte Werte – diese Datei ist öffentlich im Repo.

# URI des App-Benutzers (Atlas-Rolle: nur readWrite auf der Datenbank «subsense»), nie die des Admin-Benutzers.
# Passwort von Atlas generieren lassen; Sonderzeichen müssten URL-kodiert werden.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.sjuh9bn.mongodb.net/?appName=Cluster0

# Zufallswert mit mindestens 32 Byte, z. B.:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-secret-key-here-min-32-chars

# Nur auf Netlify nötig: Personal Access Token für den Dokumenten-Store (Netlify Blobs).
# SITE_ID setzt Netlify selbst. Lokal (npm run dev) liegen Uploads in static/uploads.
NETLIFY_BLOBS_TOKEN=

# Mail-Versand über Infomaniak my kSuite (SMTP mail.infomaniak.com:587, STARTTLS).
# SMTP_PASSWORD ist ein Gerätepasswort der Mailadresse (Mail → Adresseinstellungen →
# Passwort verwalten → Gerät hinzufügen), nicht das Passwort des Infomaniak-Kontos.
# Fehlen die drei Werte, verschickt die App nichts und läuft trotzdem.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SubSense <noreply@ik.me>"

# Nur lokal und in Netlify-Deploy-Previews/Branch-Deploys, NIE in Production:
# Mails gehen dann ausschliesslich an diese Adresse.
MAIL_TEST_RECIPIENT=

# Täglicher Erinnerungs-Lauf: Schlüssel zwischen Netlify-Zeitplan und /internal/send-reminders.
# Mindestens 32 Zeichen, sonst lehnt der Endpoint jeden Aufruf ab. Erzeugen mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Adresse, die der Zeitplan aufruft (Production: https://subsense1.netlify.app).
# Lokal nur für `netlify functions:invoke`: http://localhost:5173
SITE_URL=
